# Environment variables use the following format:
# VARIABLE_NAME=value

# Defines the database connection URL
# For local PostgreSQL development
DB_URL=jdbc:postgresql://localhost:5432/kocha_tracks

# For staging or production instance (ej. Supabase)
# DB_URL=jdbc:postgresql://[db-host]:5432/postgres?sslmode=require

# Defines the username used to access the database
DB_USERNAME=postgres

# Defines the password used to access the database
DB_PASSWORD=your_password